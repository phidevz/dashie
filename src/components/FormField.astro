---
import { inputClass } from "@/utils/styles";

interface Props<T> {
  class?: string;
  data: T;
  for: T extends unknown ? string : keyof T;
  label: string;
  type: astroHTML.JSX.HTMLInputTypeAttribute | "select";
  required?: boolean;
}

const {
  class: ptClass,
  for: inputFor,
  type: inputType,
  label,
  required,
  ...remainder
} = Astro.props;
const value = !!remainder.data ? remainder.data[inputFor] : undefined;
---

<div
  class:list={[
    ptClass,
    "group-data-[orientation=horizontal]:grid",
    "group-data-[orientation=horizontal]:grid-cols-subgrid",
    "group-data-[orientation=horizontal]:col-start-1",
    "group-data-[orientation=horizontal]:col-span-4",
    "group-data-[orientation=horizontal]:items-center",
    "group-data-[orientation=horizontal]:justify-items-end",
    "group-data-[orientation=horizontal]:gap-4",
    "group-data-[orientation=vertical]:flex",
    "group-data-[orientation=vertical]:flex-col",
    "group-data-[orientation=vertical]:gap-1",
  ]}
>
  <label for={inputFor} class="group-data-[orientation=vertical]:px-2"
    >{label}</label
  >
  <div class="flex flex-row gap-4 items-center">
    <slot name="preview" />
    {
      inputType === "select" ? (
        <select
          name={inputFor}
          class:list={[
            inputClass,
            "*:text-slate-500 *:dark:text-slate-400 *:bg-white dark:*:bg-slate-900",
          ]}
          value={value}
        >
          <slot name="options" />
        </select>
      ) : (
        <input
          type={inputType}
          name={inputFor}
          class={inputClass}
          value={value}
          required={!!required}
        />
      )
    }
  </div>
</div>
