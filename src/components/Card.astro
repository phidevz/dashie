---
import type { CardSelect } from "astro:db";

interface Props extends CardSelect {}

const { href, title, iconSrc } = Astro.props;
---

<a
  href={href}
  class="flex flex-col border rounded-md ratio ratio-1x1 max-w-40 text-center overflow-hidden shadow-lg hover:bg-slate-300/30 hover:dark:bg-slate-800/30 text-inherit border-slate-500 break-words"
  target="_blank"
>
  <div class="card-body flex flex-col flex-auto justify-between p-4">
    <img class="h-16 mx-auto" src={iconSrc ?? "/favicon.svg"} />
    <h5 class="card-title">{title}</h5>
  </div>
</a>
