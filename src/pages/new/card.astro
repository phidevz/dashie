---
import Layout from "@/layouts/Layout.astro";
import DAL, { handleCreate, removeId } from "@/utils/data";
import Form from "@/components/Form.astro";
import FormField from "@/components/FormField.astro";
import type { CardInsert } from "astro:db";
import FormButtons from "@/components/FormButtons.astro";
import SaveButton from "@/components/SaveButton.astro";
import MessageBanner from "@/components/MessageBanner.astro";

const result = await handleCreate(Astro, removeId, DAL.card.create);
if (result.result === "response") {
  return result.response;
}

const message = result.message;

const dummyData: CardInsert = undefined as unknown as CardInsert;
---

<Layout title="New card">
  {message && <MessageBanner message={message} />}
  <Form action="create">
    <FormField
      data={dummyData}
      for="title"
      label="Title"
      type="text"
      required
    />
    <FormField
      data={dummyData}
      for="ordinal"
      type="number"
      label="Ordinal (lower means further up)"
    />
    <FormButtons>
      <SaveButton />
    </FormButtons>
  </Form>
</Layout>
