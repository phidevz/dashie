---
import Layout from "@/layouts/Layout.astro";
import { type Message } from "@/utils/styles";
import DAL from "@/utils/data";
import SaveButton from "@/components/SaveButton.astro";
import FormButtons from "@/components/FormButtons.astro";
import DeleteButton from "@/components/DeleteButton.astro";
import MessageBanner from "@/components/MessageBanner.astro";
import { deleteAction, editAction } from "@/utils/actions";
import Form from "@/components/Form.astro";
import FormField from "@/components/FormField.astro";

const id = Astro.params.id;

if (!id) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

let message: Message | undefined = undefined;

let card;

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const action = data.get("__action");
    if (!action) {
      message = {
        severity: "error",
        text: "Invalid request",
      };
    } else {
      if (action === editAction) {
        if (data.has("id")) {
          data.delete("id");
        }
        const updateDto = Object.fromEntries(data.entries());
        card = await DAL.card.update(id, updateDto);
        console.log("after update", card);
        message = {
          severity: "info",
          text: "Update successful",
        };
      } else if (action === deleteAction) {
        await DAL.card.delete(id);
        return Astro.redirect(import.meta.env.BASE_URL);
      } else {
        message = {
          severity: "warning",
          text: "Unknown action",
        };
      }
    }
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
      message = {
        severity: "error",
        text: error.message,
      };
    }
  }
}
if (!card) {
  card = await DAL.card.findById(id);
}

if (!card) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

const sections = await DAL.section.list();
---

<Layout title="Edit card">
  {message && <MessageBanner message={message} />}

  <Form action="edit" orientation="vertical">
    <FormField data={card} for="title" type="text" label="Title" />
    <FormField data={card} for="href" type="text" label="Link target" />
    <FormField data={card} for="iconSrc" type="text" label="Icon (URL)">
      <img
        slot="preview"
        class="h-6 w-6"
        src={card.iconSrc}
        crossorigin="anonymous"
        hidden={!card.iconSrc}
      />
    </FormField>
    <FormField data={card} for="sectionId" type="select" label="Section">
      <Fragment slot="options">
        {
          sections.map((section) => (
            <option value={section.id}>{section.title}</option>
          ))
        }
      </Fragment>
    </FormField>
    <FormButtons>
      <SaveButton />
      <DeleteButton />
    </FormButtons>
  </Form>
</Layout>
