---
interface Props {
  title: string;
  class?: string;
}

const { title, class: ptClass } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html
  lang="en"
  class="dark [--scroll-mt:9.875rem] lg:[--scroll-mt:6.3125rem] [scrollbar-gutter:stable] js-focus-visible"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--<link rel="stylesheet" href="/src/main.css" />-->
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen overflow-y-auto antialiased text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-900"
  >
    <header
      class="sticky top-0 z-40 w-full backdrop-blur flex-none transition-colors duration-500 lg:z-50 lg:border-b lg:border-slate-900/10 dark:border-slate-50/[0.06] bg-white supports-backdrop-blur:bg-white/95 dark:bg-slate-900/75"
    >
      <a
        href={baseUrl}
        class="max-w-8xl mx-auto py-4 lg:px-8 text-2xl flex flex-row items-center gap-2"
      >
        <img class="aspect-square h-8" src="/favicon.svg" />
        <h1
          class="border-b border-slate-900/10 lg:border-0 dark:border-slate-300/10 mx-4 lg:mx-0 font-semibold text-slate-700 dark:text-slate-200"
        >
          Dashboard
        </h1>
      </a>
    </header>
    <main class:list={["max-w-8xl mx-auto py-4 lg:px-8", ptClass]}>
      <slot name="message-banner" />
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @layer tailwind-base, bootstrap, tailwind-utilities;

  @import "../bootstrap.css" layer(bootstrap);

  @layer tailwind-base {
    @tailwind base;
  }

  @layer tailwind-utilities {
    @tailwind components;
    @tailwind utilities;
  }
</style>
